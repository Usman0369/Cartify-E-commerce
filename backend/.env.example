NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/cartify

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=false

# Brevo SMTP is preferred. Create an SMTP key in Brevo, not your account password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional fallback when SMTP_USER/SMTP_PASS are empty.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Cartify

OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

ADMIN_NAME=Cartify Admin
ADMIN_EMAIL=admin@cartify.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!

RATE_LIMIT_DISABLED=false
